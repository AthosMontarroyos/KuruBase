NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://kurubase_api:replace_with_a_long_random_password@postgres:5432/kurubase
KURUBASE_API_PASSWORD=replace_with_a_long_random_password
KURUBASE_IDENTITY_ADMIN_PASSWORD=replace_with_a_third_long_random_password
KURUBASE_IDENTITY_ADMIN_DATABASE_URL=postgresql://kurubase_identity_admin:replace_with_a_third_long_random_password@127.0.0.1:5432/kurubase
POSTGRES_DB=kurubase
POSTGRES_USER=kurubase_owner
POSTGRES_PASSWORD=replace_with_a_different_long_random_password
POSTGRES_PORT=5432
API_PORT=8080
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
EXPOSED_SCHEMA=api
IDENTITY_PROVIDER=local-jwt
LOCAL_JWT_ISSUER=urn:kurubase:local
LOCAL_JWT_AUDIENCE=kurubase
LOCAL_JWT_SECRET=replace_with_at_least_32_random_characters
CLOUDFLARE_TUNNEL_TOKEN=replace_with_tunnel_token
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
