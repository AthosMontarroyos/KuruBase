NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://kurubase_api:replace_with_a_long_random_password@postgres:5432/kurubase
KURUBASE_API_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=kurubase
POSTGRES_USER=kurubase_owner
POSTGRES_PASSWORD=replace_with_a_different_long_random_password
POSTGRES_PORT=5432
API_PORT=8080
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
EXPOSED_SCHEMA=api
KURUAUTH_ISSUER=https://auth.example.com
KURUAUTH_AUDIENCE=kurubase
KURUAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
KURUAUTH_ALLOWED_ALGORITHMS=RS256
CLOUDFLARE_ACCESS_REQUIRED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_with_access_audience
CLOUDFLARE_TUNNEL_TOKEN=replace_with_tunnel_token
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
