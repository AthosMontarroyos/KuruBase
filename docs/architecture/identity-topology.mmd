    endpoints --> authTunnel
  end

  oidc -. HTTPS discovery / JWKS .-> endpoints
  access <-. Future generic OIDC IdP .-> endpoints
  platform -. pins .-> kurubase
  platform -. pins .-> kuruauth
  platform -. pins .-> kuruconsole

