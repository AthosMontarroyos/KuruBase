NODE_ENV=production
HOST=0.0.0.0
PORT=8080
API_PORT=8080
POSTGRES_DB=kurubase
POSTGRES_USER=kurubase_owner
POSTGRES_PASSWORD=replace_with_at_least_32_random_characters
KURUBASE_API_PASSWORD=replace_with_a_different_at_least_32_random_password
KURUBASE_IDENTITY_ADMIN_PASSWORD=replace_with_a_third_at_least_32_random_password
DATABASE_URL=postgresql://kurubase_api:replace_with_a_different_at_least_32_random_password@postgres:5432/kurubase
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
EXPOSED_SCHEMA=api
IDENTITY_PROVIDER=cloudflare-access
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_with_cloudflare_access_audience
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
